{
  "version": 2,
  "rewrites": [
    { "source": "/link", "destination": "/link.html" },
    { "source": "/link/status", "destination": "/api/link-status" },
    { "source": "/api/link-status", "destination": "/api/link-status" },
    { "source": "/api/supabase/status", "destination": "/api/supabase-status" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/papers", "destination": "/api/papers" },
    { "source": "/api/chat", "destination": "/api/chat" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Authorization, Accept" }
      ]
    }
  ]
}
